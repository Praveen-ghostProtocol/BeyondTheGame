{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/build_vercel.py",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{app/private/**,tests/**,docs/**,data/**,models/**,prototypes/**,final/**,.tmp/**}"
    }
  },
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index?route=:path*"}],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"},
      {"key": "Cache-Control", "value": "no-store"}
    ]
  }]
}
